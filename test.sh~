#!/bin/bash

for i in `seq -w 1 2 999`;
do 	    echo snapshot_$i.hdf5
	    cp /scratch/snx3000/hpdeng/temp/snapshot_$i.hdf5 /scratch/snx3000/hpdeng/gizmout/boxtest3/init/boxtest3-ics.hdf5
	    sbatch ~/gizmo/job/boxtest3.job
	    rm /scratch/snx3000/hpdeng/gizmout/boxtest3/snapshot_*
	    while [ ! -f /scratch/snx3000/hpdeng/gizmout/boxtest3/snapshot_001.hdf5 ]
	    do
		sleep 60s
	    done
	    cp /scratch/snx3000/hpdeng/gizmout/boxtest3/snapshot_000.hdf5 /scratch/snx3000/hpdeng/temp/snapshot_$i.hdf5
	    sleep 2m
done
