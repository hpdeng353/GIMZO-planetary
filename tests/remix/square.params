% REMIX square test (Sandnes et al. 2024 Sec 4.1) — ideal gas gamma=5/3.
% Build with conf.square (PERIODIC NOGRAVITY MFM WendlandC2).
% The run script substitutes __ICPATH__ with the converted GIZMO IC path.
InitCondFile                       __ICPATH__
OutputDir                          ./
RestartFile                        restart
SnapshotFileBase                   snapshot
OutputListFilename                 output_times.txt
ICFormat                           3
SnapFormat                         3
TimeLimitCPU                       864000
CpuTimeBetRestartFile              3500
ResubmitOn                         0
ResubmitCommand                    ./resub
MaxMemSize                         3500
PartAllocFactor                    5.
BufferSize                         80
TimeBegin                          0
TimeMax                            3.0
ComovingIntegrationOn              0
Omega0                             0
OmegaLambda                        0
OmegaBaryon                        0
HubbleParam                        1
BoxSize                            1
OutputListOn                       0
TimeBetSnapshot                    1.5
TimeOfFirstSnapshot                0
TimeBetStatistics                  0.25
NumFilesPerSnapshot                1
NumFilesWrittenInParallel          1
ErrTolIntAccuracy                  0.002
CourantFac                         0.1
MaxSizeTimestep                    0.05
MinSizeTimestep                    1e-8
TreeDomainUpdateFrequency          0.005
DesNumNgb                          80
MaxNumNgbDeviation                 0.1
ArtBulkViscConst                   1
UnitLength_in_cm                   1
UnitMass_in_g                      1
UnitVelocity_in_cm_per_s           1
UnitMagneticField_in_gauss         1
GravityConstantInternal            0
MaxHsml                            0.5
MinGasHsmlFractional               0
SofteningGas                       0.01
SofteningHalo                      0.01
SofteningDisk                      0.01
SofteningBulge                     0.01
SofteningStars                     0.01
SofteningBndry                     0.01
SofteningGasMaxPhys                0.01
SofteningHaloMaxPhys               0.01
SofteningDiskMaxPhys               0.01
SofteningBulgeMaxPhys              0.01
SofteningStarsMaxPhys              0.01
SofteningBndryMaxPhys              0.01
InitGasTemp                        0
MinGasTemp                         0
