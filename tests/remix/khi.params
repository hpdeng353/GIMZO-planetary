% REMIX iron/rock KHI (Sandnes et al. 2024 Fig. 9) — ANEOS forsterite/iron.
% Build with conf.khi (PERIODIC NOGRAVITY MFM WendlandC2 EOS_ANEOS).
% The run script substitutes __ICPATH__ with the converted GIZMO IC path.
% Code units follow the SPH-EXA IC: LU=6.371e6 m, VU=1 km/s, MU=9.5517e22 kg;
% tau_KH = 0.826245 code units, TimeMax = 2 tau_KH, snapshots every 0.5 tau_KH.
InitCondFile                       __ICPATH__
OutputDir                          ./
RestartFile                        restart
SnapshotFileBase                   snapshot
OutputListFilename                 output_times.txt
ICFormat                           3
SnapFormat                         3
TimeLimitCPU                       864000
CpuTimeBetRestartFile              3500
ResubmitOn                         0
ResubmitCommand                    ./resub
MaxMemSize                         3500
PartAllocFactor                    5.
BufferSize                         80
TimeBegin                          0
TimeMax                            1.652489
ComovingIntegrationOn              0
Omega0                             0
OmegaLambda                        0
OmegaBaryon                        0
HubbleParam                        1
BoxSize                            1
OutputListOn                       0
TimeBetSnapshot                    0.413122
TimeOfFirstSnapshot                0
TimeBetStatistics                  0.0826245
NumFilesPerSnapshot                1
NumFilesWrittenInParallel          1
ErrTolIntAccuracy                  0.002
CourantFac                         0.1
MaxSizeTimestep                    0.01
MinSizeTimestep                    1e-8
TreeDomainUpdateFrequency          0.005
DesNumNgb                          80
MaxNumNgbDeviation                 0.1
ArtBulkViscConst                   1
UnitLength_in_cm                   6.371e8
UnitMass_in_g                      9.5517e25
UnitVelocity_in_cm_per_s           1.0e5
UnitMagneticField_in_gauss         1
GravityConstantInternal            0
MaxHsml                            0.1
MinGasHsmlFractional               0
SofteningGas                       0.01
SofteningHalo                      0.01
SofteningDisk                      0.01
SofteningBulge                     0.01
SofteningStars                     0.01
SofteningBndry                     0.01
SofteningGasMaxPhys                0.01
SofteningHaloMaxPhys               0.01
SofteningDiskMaxPhys               0.01
SofteningBulgeMaxPhys              0.01
SofteningStarsMaxPhys              0.01
SofteningBndryMaxPhys              0.01
InitGasTemp                        0
MinGasTemp                         0
EosTable                           /home/hpdeng/planetg/impact-out/eos/rock_planet_aneos_62_63.spheos
EosTableMatIds                     62,63
RelaxTimescale                     0
RelaxUntil                         0
SphericalRelaxUntil                0
SphericalRelaxReleaseDuration      0
RelaxIsentropic                    0
