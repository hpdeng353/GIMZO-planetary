% REMIX iron/rock RTI (Sandnes et al. 2024 Sec 4.6, Fig. 12) — ANEOS forsterite/iron.
% Build with conf.rti (PERIODIC REFLECT_BND_Y NOGRAVITY ANALYTIC_GRAVITY
% RTI_CONST_GRAVITY_Y=-63.0729 LONG_Y=2 MFM WendlandC2 EOS_ANEOS).
% The run script substitutes __ICPATH__ with the converted GIZMO IC path.
% Code units: LU=6.371e6 m, VU=1 km/s, MU=9.5517e22 kg.
% tau_RT = 0.014203 code; TimeMax = 5 tau_RT, snapshots every 1 tau_RT.
InitCondFile                       __ICPATH__
OutputDir                          ./
RestartFile                        restart
SnapshotFileBase                   snapshot
OutputListFilename                 output_times.txt
ICFormat                           3
SnapFormat                         3
TimeLimitCPU                       864000
CpuTimeBetRestartFile              3500
ResubmitOn                         0
ResubmitCommand                    ./resub
MaxMemSize                         3500
PartAllocFactor                    5.
BufferSize                         80
TimeBegin                          0
TimeMax                            0.071016
ComovingIntegrationOn              0
Omega0                             0
OmegaLambda                        0
OmegaBaryon                        0
HubbleParam                        1
BoxSize                            0.05
OutputListOn                       0
TimeBetSnapshot                    0.014203
TimeOfFirstSnapshot                0
TimeBetStatistics                  0.014203
NumFilesPerSnapshot                1
NumFilesWrittenInParallel          1
ErrTolIntAccuracy                  0.002
CourantFac                         0.1
MaxSizeTimestep                    0.002
MinSizeTimestep                    1e-9
DesNumNgb                          80
MaxNumNgbDeviation                 0.1
ArtBulkViscConst                   1
UnitLength_in_cm                   6.371e8
UnitMass_in_g                      9.5517e25
UnitVelocity_in_cm_per_s           1.0e5
UnitMagneticField_in_gauss         1
GravityConstantInternal            0
MaxHsml                            0.005
MinGasHsmlFractional               0
SofteningGas                       0.001
SofteningHalo                      0.001
SofteningDisk                      0.001
SofteningBulge                     0.001
SofteningStars                     0.001
SofteningBndry                     0.001
SofteningGasMaxPhys                0.001
SofteningHaloMaxPhys               0.001
SofteningDiskMaxPhys               0.001
SofteningBulgeMaxPhys              0.001
SofteningStarsMaxPhys              0.001
SofteningBndryMaxPhys              0.001
InitGasTemp                        0
MinGasTemp                         0
EosTable                           /home/hpdeng/planetg/impact-out/eos/rock_planet_aneos_62_63.spheos
EosTableMatIds                     62,63
RelaxTimescale                     0
RelaxUntil                         0
SphericalRelaxUntil                0
SphericalRelaxReleaseDuration      0
RelaxIsentropic                    0
