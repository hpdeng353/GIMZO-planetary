#!/bin/bash
#SBATCH -o /zbox/data/hpdeng/gizmout/spiraldisk1/spiraldisk_1.4_1g-%j.out
#SBATCH -J spiraldisk1
#SBATCH -p debug
#SBATCH --time 0-00:30:00
#SBATCH --ntasks=32
#SBATCH --mail-user=hpdeng@physik.uzh.ch

home=/home/ics/hpdeng
GIZMO=$home/gizmo-public/GIZMO
data=/zbox/data/hpdeng/gizmout/spiraldisk1/ 
param=$data/init/spiraldisk1.params
cd $data

echo $param
echo $GIZMO
echo "***"
pwd

echo ""
echo "***** LAUNCHING *****"
echo `date '+%F %H:%M:%S'`
