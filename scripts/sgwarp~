echo $swarp
#mv /scratch/snx3000/hpdeng/gizmout/$swarp/snapshot* /scratch/snx3000/hpdeng/gizmobak/$swarp
#rm /scratch/snx3000/hpdeng/gizmout/$swarp/swarp*
