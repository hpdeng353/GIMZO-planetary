#!/bin/bash
grvmhd="grvmhd"
grvmhd=$grvmhd$1
echo $grvmhd
#mv /scratch/snx3000/hpdeng/gizmout/$grvmhd/snapshot* /scratch/snx3000/hpdeng/gizmobak/$grvmhd
#rm /scratch/snx3000/hpdeng/gizmout/$grvmhd/grvmhd*
#cp /users/hpdeng/gizmo/scripts/mhd-ics.hdf5 /scratch/snx3000/hpdeng/gizmout/$grvmhd/init/$grvmhd-ics.hdf5
cp ../$grvmhd.conf ../Config.sh
cd ../
make clean
