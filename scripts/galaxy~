mv GIZMO_config.h /scratch/snx3000/hpdeng/gizmout/$grvmhd/
cp GIZMO /scratch/snx3000/hpdeng/gizmout/$grvmhd/init/
cd /scratch/snx3000/hpdeng
cp /users/hpdeng/gizmo/job/$grvmhd.job ./
sbatch $grvmhd.job
rm $grvmhd.job
