import h5py
#import pynbody
import numpy as np
#import matplotlib.pyplot as plt
import pynbody
from scipy import interpolate
#import diskpy
#B0=np.sqrt(8.*np.pi/400)
#beta=B0*B0/8./np.pi
#beta=1./beta


#s = h5py.File('clump.hdf5','r+')
s = h5py.File('/scratch/e1000/hpdeng/gizmout/grvdisk3/init/grvdisk3-ics.hdf5','r+')


#rho = s["PartType0"]["Density"][:]
s1=pynbody.load('/scratch/e1000/hpdeng/gizmout/grvdisk3/init/grvdisk3-ics.hdf5')

pynbody.analysis.halo.center(s1,'com')#'hyb')

del s["PartType0"]["Velocities"]
#del s["PartType1"]["Velocities"]
del s["PartType0"]["Coordinates"]
#del s["PartType1"]["Coordinates"]

#warning  the midplane rad rad1
pos=s1.g['pos']
vel=s1.g['vel']

xx=pos[:,0]
yy=pos[:,1]
zz=pos[:,2]
vx=vel[:,0]
vy=vel[:,1]
vz=vel[:,2]

beta=np.loadtxt('beta.txt')
rr=np.loadtxt('rr.txt')

fb=interpolate.interp1d(rr,beta,fill_value="extrapolate")

rad=np.sqrt(pos[:,0]*pos[:,0]+pos[:,1]*pos[:,1])
phin=np.pi+np.arctan2(yy,xx)

betan=fb(rad)
phi=np.linspace(0.,2,400)*np.pi
Hphi=np.loadtxt('Hphi2.txt')
fh=interpolate.interp2d(rr,phi,Hphi.T)
for i in range(0,len(rr)-1):  #array too large inteplation one cell by one cell
    print (rr[i])
    for j in range(0,len(phi)-1):
        rcell=rad[np.where((rad>rr[i])&(rad<=rr[i+1])&(phin>phi[j])&(phin<=phi[j+1]))]
        phicell=phin[np.where((rad>rr[i])&(rad<=rr[i+1])&(phin>phi[j])&(phin<=phi[j+1]))]
        sH=(Hphi[i,j]+Hphi[i,j+1]+Hphi[i+1,j]+Hphi[i+1,j+1])/4
        zz[np.where((rad>rr[i])&(rad<=rr[i+1])&(phin>phi[j])&(phin<=phi[j+1]))]*=sH
        


#rr=np.sqrt(pos[:,0]*pos[:,0]+pos[:,1]*pos[:,1]+pos[:,2]*pos[:,2])


lx=np.sin(betan)
lz=np.cos(betan)

pos[:,0]=lz*xx+lx*zz
pos[:,2]=-lx*xx+lz*zz
vel[:,0]=lz*vx+lx*vz
vel[:,2]=-lx*vx+lz*vz
vel[:,1]=vy


#vel1=s1.s['vel']
#pos1=s1.s['pos']


s.create_dataset("PartType0/Coordinates",data=pos)
s.create_dataset("PartType0/Velocities",data=vel)
#s.create_dataset("PartType1/Coordinates",data=pos1)
#s.create_dataset("PartType1/Velocities",data=vel1)



s.flush()
s.close()
