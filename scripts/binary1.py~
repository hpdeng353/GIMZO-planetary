import h5py
import numpy as np

s = h5py.File('/scratch/snx3000/hpdeng/gizmout/grvdisk1/init/grvdisk1-ics.hdf5','r+')





mass = np.asarray([0.5,0.5])
pos=[[-0.2,0.,0.],[0.2,0.,0.]]
vel=[[0.,-0.7746,0.],[0.,0.7746,0.]]


del s["PartType5"]["Masses"]
del s["PartType5"]["Coordinates"]
del s["PartType5"]["Velocities"]


s.create_dataset("PartType5/Masses",data=mass)
s.create_dataset("PartType5/Coordinates",data=pos)
s.create_dataset("PartType5/Velocities",data=vel)

print "one dark particle added"
    

s.flush()
s.close()
            

