#!/bin/bash
ngrvmhd="ngrvmhd"
ngrvmhd=$ngrvmhd$1
echo $ngrvmhd
cp /home/ics/hpdeng/gizmo-public/scripts/disk_ics.hdf5 /zbox/data/hpdeng/gizmout/$ngrvmhd/init/$ngrvmhd-ics.hdf5
cp ../ngrvmhd.conf ../Config.sh
cd ../
make clean
make
mv GIZMO_config.h /zbox/data/hpdeng/gizmout/$ngrvmhd/
cp GIZMO /zbox/data/hpdeng/gizmout/$ngrvmhd/init/
sbatch job/$ngrvmhd.job