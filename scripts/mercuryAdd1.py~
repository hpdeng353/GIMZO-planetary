import h5py
import numpy as np

s = h5py.File('/scratch/snx3000/hpdeng/gizmout/moon1/init/moon1-ics.hdf5','r+')

npart=s["Header"].attrs["NumPart_ThisFile"]
Npart=s["Header"].attrs["NumPart_Total"]
Ngas=npart[0]

npart = npart + [0,0,1,0,0,0]
Npart = Npart + [0,0,1,0,0,0]

s["Header"].attrs.modify("NumPart_ThisFile",npart)
s["Header"].attrs.modify("NumPart_Total",Npart)

pos = s["PartType0"]["Coordinates"][:]
vel=s["PartType0"]["Velocities"][:]

mass=62.46*0.8
mass1=s["PartType0"]["Masses"][:]
mass1=np.sum(mass1)
gamma=mass1/(mass+mass1)

print "mass=", mass1/62.46, mass/62.46
print "gamma=", gamma

deltax=-5. #(rr+rr1)*1.02*np.sqrt(1.-b*b) + (rr+rr1)*4.
deltay=12.815#-(rr+rr1)*1.05

xx= -deltax*gamma
xx1= deltax*(1-gamma)
yy= -deltay*gamma
yy1=deltay*(1-gamma)

pos[:,0]+=xx1 
pos[:,1]+= yy1

deltav=0.97#np.sqrt(1.12/(rr+rr1))*11.18*(1.05-0.)#1./np.sqrt(deltay*deltay + deltax*deltax))
deltavy=8.445
#deltav=9.2*1.15
vv= deltav*gamma
vv1= -deltav*(1-gamma)
vvy= deltavy*gamma
vvy1= -deltavy*(1-gamma)

vx=np.average(vel[:,0])
vy=np.average(vel[:,1])
vel[:,0]-=vx
vel[:,1]-=vy

vel[:,0] += vv1
vel[:,1] += vvy1

ids = np.asarray([1000003,])
mass = np.asarray([mass,])
pos1=[[xx,yy,0.],]
vel1=[[vv, vvy,0],]


del s["PartType0"]["Coordinates"]
del s["PartType0"]["Velocities"]

s.create_dataset("PartType2/Masses",data=mass)
s.create_dataset("PartType2/ParticleIDs",data=ids)
s.create_dataset("PartType0/Coordinates",data=pos)
s.create_dataset("PartType2/Coordinates",data=pos1)
s.create_dataset("PartType2/Velocities",data=vel1)
s.create_dataset("PartType0/Velocities",data=vel)

print "planet particle added"
    

s.flush()
s.close()
            

