ample=0.1
Lx=90.496
kx=np.pi*2/Lx
gamma_eos=1.001
#s = h5py.File('clump.hdf5','r+')
s = h5py.File('/scratch/snx3000/hpdeng/gizmout/boxtest3/init/boxtest3-ics.hdf5','r+')

#rho = s["PartType0"]["Density"][:]

vel=s["PartType0"]["Velocities"][:]
