pos=s["PartType0"]["Coordinates"]
del s["PartType0"]["Coordinates"]

xx=pos[:,0]-Lx/2.
pos[:,2]+=ample*np.cos(kx*xx)
vel[:,0]=ample*(pos[:,2]-12)*np.cos(kx*xx)
vel[:,2]=ample*np.sin(kx*xx)
vel[:,1]+=0.5*ample*(pos[:,2]-12)*np.sin(kx*xx) #?? wrong??

#vel[:,0]+=ample*(pos[:,2]-12)


s.create_dataset("PartType0/Coordinates",data=pos)
s.create_dataset("PartType0/Velocities",data=vel)





