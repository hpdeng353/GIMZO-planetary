#!/bin/bash
grvdisk="grvdisk"
grvdisk=$grvdisk$1
echo $grvdisk
#mv /scratch/snx3000/hpdeng/gizmout/$grvdisk/snapshot* /scratch/snx3000/hpdeng/gizmobak/$grvdisk
#rm /scratch/snx3000/hpdeng/gizmout/$grvdisk/grvdisk*
#cp /users/hpdeng/gizmo/scripts/disk-ics.hdf5 /scratch/snx3000/hpdeng/gizmout/$grvdisk/init/$grvdisk-ics.hdf5
cp ../$grvdisk.conf ../Config.sh
cd ../
make clean
make
mv GIZMO_config.h /scratch/snx3000/hpdeng/gizmout/$grvdisk/
cp GIZMO /scratch/snx3000/hpdeng/gizmout/$grvdisk/init/
cd /scratch/snx3000/hpdeng
cp /users/hpdeng/gizmo/job/$grvdisk.job ./
sbatch $grvdisk.job
rm $grvdisk.job
