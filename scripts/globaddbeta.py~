import h5py
import numpy as np


beta=25
gamma_eos=5.0/3.
#B0=np.sqrt(8.*np.pi/400)
#beta=B0*B0/8./np.pi
#beta=1./beta



s = h5py.File('/scratch/snx3000/hpdeng/gizmout/grvmhd4/init/grvmhd4-ics.hdf5','r+')

#mag = s["PartType0"]["Velocities"][:]
pos = s["PartType0"]["Coordinates"][:]
u = s["PartType0"]["InternalEnergy"][:]
rho = s["PartType0"]["Density"][:]
#id1= s["PartType1"]["ParticleIDs"][:]
#id1[0]=50000000
mass=s["PartType0"]["Masses"][:]
#del s["PartType0"]["Masses"]
mass*=1.2
#del s["PartType0"]["MagneticField"]
#del s["PartType0"]["InternalEnergy"]
#del s["PartType1"]["ParticleIDs"]
pos[:,0] -= np.average(pos[:,0])
pos[:,1] -= np.average(pos[:,1])
pos[:,2] -= np.average(pos[:,2])
rr=np.sqrt(pos[:,0]*pos[:,0]+pos[:,1]*pos[:,1])#+pos[:,2]*pos[:,2])
sin = pos[:,1]/rr
cos = pos[:,0]/rr
theta=np.arctan2(pos[:,1],pos[:,0])


p_fiducial=rho*u*(gamma_eos-1)*5.27*1e6#np.average(rho1*cs21)*5.27*1e6
bample=np.sqrt(p_fiducial/beta*8*np.pi)
mag=pos[:,:]
bx= - bample * sin 
by= bample * cos
bx[np.where(rho<1e-6)]==0
by[np.where(rho<1e-6)]==0
#bx[np.where((pos[:,2]>0.1)|(pos[:,2]<-0.1)|(rr<5))]=0
#by[np.where((pos[:,2]>0.1)|(pos[:,2]<-0.1)|(rr<5))]=0
#rho[np.where(rho<1.e10)]=0
#rho[np.where(rho>1e10)]=0.0001

mag[:,1] =0.
mag[:,0] =0.
mag[:,2] = 10.*np.cos(theta*2)
#0.002 pure vertical

#u*=66.
s.create_dataset("PartType0/MagneticField",data=mag)
#s.create_dataset("PartType0/Masses",data=mass)
#s.create_dataset("PartType0/InternalEnergy",data=u)
#s.create_dataset("PartType1/ParticleIDs",data=id1)
s.flush()
s.close()
            

