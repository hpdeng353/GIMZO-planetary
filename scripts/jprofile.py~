import h5py
import numpy as np
import matplotlib.pyplot as plt


s = h5py.File('/scratch/snx3000/hpdeng/gizmout/grvdisk3/sphere128/snapshot_000.hdf5','r+')

bins=np.arange(0,0.8,0.04)
vel = s["PartType0"]["Velocities"][:]
u = s["PartType0"]["InternalEnergy"][:]
rho = s["PartType0"]["Density"][:]
coord= s["PartType0"]["Coordinates"][:]

del s["PartType0"]["Velocities"]

ample1=0.5

jz=coord[:,0]*vel[:,1]-coord[:,1]*vel[:,0]
rad=np.sqrt(coord[:,0]*coord[:,0]+coord[:,1]*coord[:,1])
jbins=[0,]
for i in range(0,len(bins)-1):
    temp=np.average(jz[np.where((np.fabs(coord[:,2])<0.1)&(rad>bins[i])&(rad<bins[i+1]))])
    jbins.append(temp)


jbins=np.asarray(jbins)
plt.plot(bins,jbins)

            

