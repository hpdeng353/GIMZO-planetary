#!/bin/bash            # this line only there to enable syntax highlighting in this file
# REMIX square test (Sandnes et al. 2024 Sec 4.1): isobaric dense cube in a
# periodic box, ideal gas gamma=5/3, no gravity. Same hydro method and kernel
# as production (MFM + Wendland C2); ideal-gas EOS path (no EOS_* flags).

PERIODIC                        # cubic periodic box [0,1]^3
NOGRAVITY                       # pure hydro test
HYDRO_MESHLESS_FINITE_MASS      # Lagrangian (constant-mass) finite-volume Godunov method
KERNEL_FUNCTION=6               # Wendland C2, same as impact.conf production
HAVE_HDF5                       # HDF5 I/O
